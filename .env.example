# Khoá API Claude (lấy ở https://console.anthropic.com). Thiếu khoá thì thầy dùng kho câu dự phòng.
ANTHROPIC_API_KEY=

# Model thầy dùng để phán. Mặc định claude-opus-5-5.
# Muốn rẻ hơn nhiều (khoảng 40 lần) thì đổi sang claude-haiku-5-5.
THAYPHAN_MODEL=claude-opus-5-5

# Cổng chạy server
PORT=3000

# --- Chốt chặn chi phí (để trống thì dùng mặc định) ---
# Tối đa số lượt gọi AI mỗi ngày cho cả trang (giờ Việt Nam). Quá thì thầy rút quẻ trong kho.
DAILY_AI_LIMIT=2000
# Mỗi câu hỏi chỉ bao nhiêu lần phán đầu dùng AI; hỏi lại nữa thì rút quẻ trong kho.
AI_PER_QUESTION=2
# Mỗi câu hỏi nhớ tối đa bao nhiêu câu phán. Nhớ đủ rồi thì xoay vòng, không gọi AI nữa.
CACHE_SIZE=5
# Số lượt hỏi mỗi phút cho mỗi IP.
RATE_PER_MIN=15

# --- Redis (bắt buộc nên có trên Vercel) ---
# Lấy ở upstash.com, hoặc gắn Upstash qua Vercel Marketplace (Vercel tự điền KV_REST_API_URL/TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chạy sau proxy (Nginx, Cloudflare) thì đặt 1 để lấy IP thật từ x-forwarded-for. Vercel không cần.
TRUST_PROXY=
